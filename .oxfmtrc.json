{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "semi": false,
  "sortImports": true,
  "sortPackageJson": false,
  "sortTailwindcss": true,
  "ignorePatterns": [
    "tools/typescript-lint-policy/**",
    "target/**",
    "apps/web/dist/**",
    "node_modules/**",
    "receipts/**",
    "crates/siftwire/tests/fixtures/email/*.html",
    "docs/agent-eval-results/**",
    "**/*.md"
  ]
}
