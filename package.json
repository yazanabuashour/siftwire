{
  "name": "siftwire",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://github.com/yazanabuashour/siftwire",
  "repository": "github:yazanabuashour/siftwire",
  "type": "module",
  "scripts": {
    "typecheck": "bun node_modules/@typescript/native/bin/tsc -p tsconfig.tooling.json --noEmit",
    "format": "oxfmt --check .",
    "format:write": "oxfmt .",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "check": "bash scripts/ci.sh"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@oxlint/plugins": "1.86.0",
    "@types/node": "^26.1.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@yazanabuashour/oxlint-config": "file:tools/typescript-lint-policy",
    "bun-types": "^1.3.14",
    "oxfmt": "0.61.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
