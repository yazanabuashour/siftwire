{
  "name": "siftwire",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://github.com/yazanabuashour/siftwire",
  "repository": "github:yazanabuashour/siftwire",
  "workspaces": [
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "cargo build --locked --release -p siftwire-console && bun --cwd apps/web build",
    "dev:web": "bun --cwd apps/web dev",
    "typecheck": "bun --cwd apps/web typecheck && bun node_modules/@typescript/native/bin/tsc -p tsconfig.tooling.json --noEmit",
    "test:web": "vitest run",
    "format": "oxfmt --check .",
    "format:write": "oxfmt .",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "check": "bash scripts/ci.sh"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@types/node": "^26.1.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@yazanabuashour/oxlint-config": "file:tools/typescript-lint-policy",
    "bun-types": "^1.3.14",
    "jsdom": "^29.1.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.78.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
